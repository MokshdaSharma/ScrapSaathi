{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@scrapsaathi/api-client": ["./frontend/shared/api-client/src/index.ts"],
      "@scrapsaathi/route-optimizer": ["./frontend/shared/route-optimizer/src/index.ts"],
      "@scrapsaathi/ui-components": ["./frontend/shared/ui-components/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "env"]
}
