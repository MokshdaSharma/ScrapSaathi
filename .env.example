# Environment variables for ScrapSaathi frontend
# Copy this file to .env.local for local development

# Mock API runs on port 4000 by default
VITE_API_BASE_URL=http://localhost:4000

# For production: set this to the deployed AWS API Gateway base URL
# VITE_API_BASE_URL=https://xxxx.execute-api.ap-south-1.amazonaws.com/prod
